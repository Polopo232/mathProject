@model mathProject.Models.FunktsiooniUurimine

@{
    ViewData["Title"] = "Lisa uus funktsioon";
}

<div class="container mt-4" style="max-width: 650px;">
    <!-- Заголовок и главная кнопка -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-normal m-0">Uue funktsiooni lisamine</h3>
        <button type="button" class="btn btn-outline-dark btn-sm" onclick="generateRandomFunction()">
            🎲 Suvalised andmed
        </button>
    </div>

    <!-- Быстрые шаблоны -->
    <div class="mb-3">
        <div class="btn-group btn-group-sm w-100" role="group">
            <button type="button" class="btn btn-outline-secondary" onclick="applyTemplate('x^2 - 4*x + 3', '2*x - 4', 'X: (-inf, inf)', 'x = 2', 'min = -1 (kui x = 2)')">Ruutfunktsioon</button>
            <button type="button" class="btn btn-outline-secondary" onclick="applyTemplate('x^3 - 3*x', '3*x^2 - 3', 'X: (-inf, inf)', 'x1 = -1, x2 = 1', 'max = 2 (x=-1), min = -2 (x=1)')">Kuupfunktsioon</button>
            <button type="button" class="btn btn-outline-secondary" onclick="applyTemplate('2*x + 1', '2', 'X: (-inf, inf)', 'Puuduvad', 'Puuduvad')">Lineaarfunktsioon</button>
        </div>
    </div>

    <form asp-action="Create" method="post">
        <!-- Поле Valem (Формула) -->
        <div class="mb-3">
            <label asp-for="Valem" class="form-label small text-muted">Valem f(x)</label>
            <div class="input-group">
                <input asp-for="Valem" id="valemInput" class="form-control" placeholder="nt x^2 - 4*x + 3" required />
                <button type="button" class="btn btn-light border" onclick="insertSymbol('^2')">x²</button>
                <button type="button" class="btn btn-light border" onclick="insertSymbol('^3')">x³</button>
                <button type="button" class="btn btn-light border" onclick="insertSymbol('*')">×</button>
            </div>
            <span asp-validation-for="Valem" class="text-danger small"></span>
        </div>

        <!-- Поле Tuletis (Производная) -->
        <div class="mb-3">
            <label asp-for="Tuletis" class="form-label small text-muted">Tuletis f'(x)</label>
            <div class="input-group">
                <input asp-for="Tuletis" id="tuletisInput" class="form-control" placeholder="nt 2*x - 4" />
                <button type="button" class="btn btn-light border" onclick="insertSymbolToId('tuletisInput', '^2')">x²</button>
                <button type="button" class="btn btn-light border" onclick="insertSymbolToId('tuletisInput', '*')">×</button>
            </div>
        </div>

        <div class="row g-2 mb-3">
            <!-- Поле Maaramispiirkond -->
            <div class="col-md-6">
                <label asp-for="Maaramispiirkond" class="form-label small text-muted">Määramispiirkond</label>
                <input asp-for="Maaramispiirkond" id="maaramisInput" class="form-control" placeholder="nt X: (-inf, inf)" />
            </div>

            <!-- Поле KriitilisedPunktid -->
            <div class="col-md-6">
                <label asp-for="KriitilisedPunktid" class="form-label small text-muted">Kriitilised punktid</label>
                <input asp-for="KriitilisedPunktid" id="kriitilisedInput" class="form-control" placeholder="nt x = 2" />
            </div>
        </div>

        <!-- Поле Ekstreemumid -->
        <div class="mb-4">
            <label asp-for="Ekstreemumid" class="form-label small text-muted">Ekstreemumid</label>
            <input asp-for="Ekstreemumid" id="ekstreemumidInput" class="form-control" placeholder="nt min = -1 (kui x = 2)" />
        </div>

        <!-- Кнопки действий -->
        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
            <a asp-action="Index" class="btn btn-link text-decoration-none text-secondary p-0">← Tagasi nimekirja</a>
            <button type="submit" class="btn btn-primary px-4">Salvesta</button>
        </div>
    </form>
</div>

<script>
    const randomPresets = [
        { valem: "x^2 - 6*x + 8", tuletis: "2*x - 6", maaramis: "X: (-inf, inf)", kriitilised: "x = 3", ekstreemumid: "min = -1 (kui x = 3)" },
        { valem: "2*x^2 - 8*x", tuletis: "4*x - 8", maaramis: "X: (-inf, inf)", kriitilised: "x = 2", ekstreemumid: "min = -8 (kui x = 2)" },
        { valem: "x^3 - 12*x", tuletis: "3*x^2 - 12", maaramis: "X: (-inf, inf)", kriitilised: "x1 = -2, x2 = 2", ekstreemumid: "max = 16 (x=-2), min = -16 (x=2)" },
        { valem: "-x^2 + 4*x - 3", tuletis: "-2*x + 4", maaramis: "X: (-inf, inf)", kriitilised: "x = 2", ekstreemumid: "max = 1 (kui x = 2)" }
    ];

    function generateRandomFunction() {
        const item = randomPresets[Math.floor(Math.random() * randomPresets.length)];
        applyTemplate(item.valem, item.tuletis, item.maaramis, item.kriitilised, item.ekstreemumid);
    }

    function applyTemplate(valem, tuletis, maaramis, kriitilised, ekstreemumid) {
        document.getElementById('valemInput').value = valem;
        document.getElementById('tuletisInput').value = tuletis;
        document.getElementById('maaramisInput').value = maaramis;
        document.getElementById('kriitilisedInput').value = kriitilised;
        document.getElementById('ekstreemumidInput').value = ekstreemumid;
    }

    function insertSymbol(symbol) {
        insertSymbolToId('valemInput', symbol);
    }

    function insertSymbolToId(elementId, symbol) {
        const input = document.getElementById(elementId);
        const start = input.selectionStart;
        const end = input.selectionEnd;
        const text = input.value;
        input.value = text.substring(0, start) + symbol + text.substring(end);
        input.focus();
        input.selectionStart = input.selectionEnd = start + symbol.length;
    }
</script>