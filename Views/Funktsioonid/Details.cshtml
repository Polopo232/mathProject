@model mathProject.Models.FunktsiooniUurimine

@{
    ViewData["Title"] = "Graafik ja detailid";
    var xVals = System.Text.Json.JsonSerializer.Serialize(ViewBag.XValues ?? new List<double>());
    var yFunc = System.Text.Json.JsonSerializer.Serialize(ViewBag.YFunction ?? new List<double>());
    var yDeriv = System.Text.Json.JsonSerializer.Serialize(ViewBag.YDerivative ?? new List<double>());
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-zoom"></script>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="m-0">Funktsiooni analüüs: <code>f(x) = @Model.Valem</code></h3>
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="resetZoom()">
            ↺ Taasta vaade (Reset Zoom)
        </button>
    </div>

    <div class="card p-3 my-3">
        <canvas id="funktsiooniGraafik" width="600" height="350"></canvas>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">Tagasi nimekirja</a>
</div>

<script>
    const xVaartused = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.XValues ?? new List<double>()));
    const yFunktsioon = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.YFunction ?? new List<double>()));
    const yTuletis = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.YDerivative ?? new List<double>()));

    const datasetF = xVaartused.map((x, i) => ({ x: x, y: yFunktsioon[i] }));
    const datasetD = xVaartused.map((x, i) => ({ x: x, y: yTuletis[i] }));

    const ctx = document.getElementById('funktsiooniGraafik').getContext('2d');

    const myChart = new Chart(ctx, {
        type: 'scatter',
        data: {
            datasets: [
                {
                    label: 'f(x) = ' + '@Model.Valem',
                    data: datasetF,
                    showLine: true,
                    borderColor: '#0d6efd',
                    borderWidth: 2.5,
                    backgroundColor: '#0d6efd',
                    pointRadius: 0,
                    tension: 0.1
                },
                {
                    label: "f'(x) = " + '@Model.Tuletis',
                    data: datasetD,
                    showLine: true,
                    borderColor: '#dc3545',
                    borderWidth: 2,
                    borderDash: [6, 6],
                    backgroundColor: '#dc3545',
                    pointRadius: 0,
                    tension: 0.1
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: true,
            scales: {
                x: {
                    type: 'linear',
                    position: 'center',
                    min: -10,
                    max: 10,
                    title: { display: true, text: 'X', font: { weight: 'bold', size: 14 } },
                    grid: {
                        color: (context) => context.tick.value === 0 ? '#000000' : '#e0e0e0',
                        lineWidth: (context) => context.tick.value === 0 ? 2 : 1
                    }
                },
                y: {
                    type: 'linear',
                    position: 'center',
                    min: -10,
                    max: 10,
                    title: { display: true, text: 'Y', font: { weight: 'bold', size: 14 } },
                    grid: {
                        color: (context) => context.tick.value === 0 ? '#000000' : '#e0e0e0',
                        lineWidth: (context) => context.tick.value === 0 ? 2 : 1
                    }
                }
            },
            plugins: {
                legend: { position: 'top' },
                zoom: {
                    pan: {
                        enabled: true,
                        mode: 'xy'
                    },
                    zoom: {
                        wheel: {
                            enabled: true
                        },
                        pinch: {
                            enabled: true
                        },
                        mode: 'xy'
                    }
                }
            }
        }
    });
    function resetZoom() {
        myChart.resetZoom();
    }
</script>