@model mathProject.Models.FunktsiooniUurimine

@{
    ViewData["Title"] = "Muuda funktsiooni";
}

<div class="container mt-4" style="max-width: 650px;">
    <h3 class="fw-normal mb-3">Funktsiooni muutmine</h3>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <partial name="_Vorm" model="Model" />

        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
            <a asp-action="Index" class="btn btn-link text-decoration-none text-secondary p-0">← Tagasi nimekirja</a>
            <button type="submit" class="btn btn-primary px-4">Salvesta muudatused</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
